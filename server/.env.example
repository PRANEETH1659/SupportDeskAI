# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit the real .env file to GitHub.

PORT=5000

# Local MongoDB, or your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/supportdesk

# Any long random string; used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-3.5-flash
